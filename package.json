{
  "name": "videos",
  "version": "1.0.0",
  "description": "Videos verticales hechos con Claude Code + Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render",
    "render:reel": "remotion render ReelAgente salida/reel-agente-final.mp4",
    "render:proceso": "remotion render ProcesoAgente salida/proceso.mp4",
    "render:ventajas": "remotion render VentajasAgente salida/ventajas.mp4",
    "master": "./scripts/masterizar.sh",
    "audio": "./scripts/generar-audio.sh && node scripts/generar-musica.mjs",
    "render:subtitulos": "remotion render VideoConSubtitulos salida/video-con-subtitulos.mp4",
    "render:intro": "remotion render IntroTitulo salida/intro.mp4",
    "render:grafico": "remotion render GraficoBarras salida/grafico.mp4",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
